rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isWhitelisted() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }
    function myRole() {
      return get(/databases/$(database)/documents/allowlist/$(request.auth.token.email)).data.role;
    }
    function isAdmin() {
      return isWhitelisted() && myRole() == "admin";
    }
    function isTester() {
      return isWhitelisted() && myRole() == "tester";
    }

    // Whitelist: un utente legge solo la PROPRIA voce (serve al controllo
    // di accesso all'avvio, vedi services/authStore.js); un admin legge
    // anche l'intera collezione (serve alla schermata di gestione utenti).
    // Scritture: solo admin, e solo su voci base/tester — il ruolo admin
    // resta intoccabile dall'app in ogni verso: si gestisce a mano da
    // Firebase Console, che usa permessi IAM e bypassa queste regole.
    match /allowlist/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());

      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly(['role']) &&
        request.resource.data.role in ['base', 'tester'];

      allow update: if isAdmin() &&
        resource.data.role != 'admin' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
        request.resource.data.role in ['base', 'tester'];

      allow delete: if isAdmin() && resource.data.role != 'admin';

      // Preferenza personale "libro predefinito all'avvio": ogni utente
      // può scrivere solo il PROPRIO campo defaultBookId sulla propria
      // voce — indipendente dalla gestione ruoli (regola sopra).
      allow update: if isSignedIn() && request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defaultBookId']);

      // Preferenza personale sui canali di avviso dei timer di cucina
      // (suono/vibrazione/visivo): stesso schema di defaultBookId sopra.
      allow update: if isSignedIn() && request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timerAlerts']);

      // Template PDF personalizzati (mappa id -> PdfTemplateConfig, vedi
      // src/utils/pdfStyles.js e services/authStore.js): stesso schema di
      // defaultBookId sopra. Le scritture usano notazione a punti
      // (pdfTemplates.<id>) per creare/rinominare/eliminare un singolo
      // template senza toccare gli altri — affectedKeys() vede comunque
      // solo la chiave di primo livello "pdfTemplates", quindi la stessa
      // regola copre sia l'aggiunta/modifica sia l'eliminazione di un
      // singolo template (FieldValue.delete() su un percorso annidato).
      allow update: if isSignedIn() && request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pdfTemplates']);

      // Preferenza personale "template PDF predefinito": stesso schema di
      // defaultBookId sopra.
      allow update: if isSignedIn() && request.auth.token.email == email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defaultPdfTemplateId']);
    }

    // Interruttore globale per il pulsante β di segnalazione bug (non
    // riguarda il Ricettario Beta books/b1, che resta accessibile per ruolo
    // indipendentemente da questo flag). Se il documento non esiste, il
    // client lo tratta come enabled:true (vedi services/authStore.js) —
    // nessuna scrittura di migrazione necessaria per chi aggiorna da prima
    // che questo flag esistesse.
    match /config/beta {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }

    // Interruttore globale (per tutti gli utenti) tra emoji storiche e il
    // nuovo set di icone SVG per l'interfaccia fissa — vedi
    // services/authStore.js. Stesso schema di config/beta sopra.
    match /config/icons {
      allow read: if isWhitelisted();
      allow write: if isAdmin();
    }

    // Ricettario Beta — libro condiviso di test, accesso per RUOLO (non
    // membership): chiunque sia tester o admin, oggi e in futuro, senza
    // bisogno di inviti — stesso meccanismo già usato per reports/.
    match /books/b1 {
      allow read, write: if isAdmin() || isTester();
      match /{document=**} {
        allow read, write: if isAdmin() || isTester();
      }
    }

    // Libri: ogni libro ha un owner e una mappa di membri con RUOLO
    // (meta.memberRoles) — quattro livelli: proprietario (solo meta.owner,
    // mai in memberRoles), collaboratore, redattore, lettore. "edit"/"read"
    // sono alias legacy dallo schema a due livelli precedente: MAI riscritti
    // nei documenti esistenti, solo interpretati qui — stesso approccio già
    // usato altrove nel progetto per gli schemi di dati vecchi (mai una
    // migrazione forzata, solo lettura difensiva). "edit" legacy diventa
    // equivalente a redattore (vedi src/utils/bookRoles.js, la stessa
    // mappa, fonte di verità unica insieme a questo file — le regole non
    // possono importare JS, la duplicazione qui è minima e verificata da
    // tests/firestore.rules.test.js perché non diverga in silenzio).
    //
    // memberEmails è un array piatto degli stessi indirizzi, usato solo per
    // la query "i miei libri" (array-contains). Un'email non whitelisted
    // aggiunta per errore ai membri resta comunque bloccata da
    // isWhitelisted() qui sotto: non serve validare altrove che gli
    // invitati siano già in whitelist.
    match /books/{bookId} {
      // A questo livello "resource" è il documento libro stesso — corretto
      // usare resource.data.meta direttamente (niente get() extra).
      function isBookOwner() { return isWhitelisted() && resource.data.meta.owner == request.auth.token.email; }
      function myBookRole()  { return resource.data.meta.memberRoles[request.auth.token.email]; }
      function isBookMember(){ return request.auth.token.email in resource.data.meta.memberEmails; }
      // Chi può scrivere contenuti (ricette, Organizza, tag, sezioni) — il
      // lettore è l'unico realmente limitato. Specchio minimo di
      // EDITOR_ROLES in bookRoles.js.
      function isEditorRole(role) { return role in ['collaboratore', 'redattore', 'edit']; }
      function canEditBook() { return isBookOwner() || isEditorRole(myBookRole()); }

      allow read: if isWhitelisted() && (isBookOwner() || isBookMember());

      // Creazione ed eliminazione: MAI dal client — solo via /api/create-book
      // e /api/delete-book (Admin SDK, bypassano le regole), che applicano
      // il limite di 10 libri per utente in modo non aggirabile (un
      // contatore mantenuto solo qui sarebbe aggirabile da chi salta l'app).
      allow create: if false;
      allow delete: if false;

      // Modifica del libro (nome/tema): chi può editare contenuti in
      // generale. memberEmails/memberRoles NON sono mai in questo elenco,
      // per NESSUNO (proprietario incluso): la gestione membri passa solo
      // da /api/manage-book-member (Admin SDK, bypassa le regole) — un solo
      // punto d'ingresso invece di duplicare la matrice di permessi qui.
      allow update: if isWhitelisted() && canEditBook() &&
        request.resource.data.meta.diff(resource.data.meta).affectedKeys().hasOnly(['name', 'bookTheme']);

      // Sotto-collezioni enumerate esplicitamente (non un match generico
      // {document=**} unico): le regole Firestore sono permissive per
      // unione, quindi un catch-all con "allow write" bloccherebbe la
      // delete-per-ruolo delle ricette solo in apparenza — quel permesso
      // largo la riaprirebbe comunque. Meglio un match dedicato per ognuna.
      //
      // Qui dentro "resource" è il documento della SOTTO-collezione, non il
      // libro: owner/ruolo vanno letti dal libro con un get() esplicito
      // (stesso pattern già usato in questo file prima di questa modifica).
      function parentBook() { return get(/databases/$(database)/documents/books/$(bookId)).data.meta; }
      function isParentOwner() { return isWhitelisted() && parentBook().owner == request.auth.token.email; }
      function isParentMember() { return request.auth.token.email in parentBook().memberEmails; }
      function myParentRole() { return parentBook().memberRoles[request.auth.token.email]; }
      function canEditParent() { return isParentOwner() || isEditorRole(myParentRole()); }
      // Chi può eliminare ricette/ricordi — solo proprietario e
      // collaboratore, mai un "edit" legacy (che oggi equivale a redattore,
      // non a collaboratore: perde la delete finché non viene promosso).
      function canDeleteContent() { return isParentOwner() || myParentRole() == "collaboratore"; }

      match /recipes/{recipeId} {
        function memoriesCount(data) { return "memories" in data ? data.memories.size() : 0; }
        function isMemoryRemoval() { return memoriesCount(request.resource.data) < memoriesCount(resource.data); }

        allow read: if isWhitelisted() && (isParentOwner() || isParentMember());
        allow create: if isWhitelisted() && canEditParent();
        // Un redattore può aggiungere/modificare un ricordo, non rimuoverlo
        // (l'array si accorcia) — quello richiede canDeleteContent(), come
        // l'eliminazione della ricetta stessa.
        allow update: if isWhitelisted() && canEditParent() && (!isMemoryRemoval() || canDeleteContent());
        allow delete: if isWhitelisted() && canDeleteContent();
      }

      match /system/{document} {
        allow read: if isWhitelisted() && (isParentOwner() || isParentMember());
        allow write: if isWhitelisted() && canEditParent();
      }

      match /shoppingList/{document} {
        allow read: if isWhitelisted() && (isParentOwner() || isParentMember());
        allow write: if isWhitelisted() && canEditParent();
      }
    }

    // Segnalazioni beta (bug/miglioramenti) — collezione globale, non
    // legata a un libro specifico. Lettura e creazione per admin/tester;
    // solo admin può cambiare stato (status/resolvedBy/resolvedAt) e non
    // può toccare il resto del documento in quello stesso update.
    match /reports/{reportId} {
      allow read: if isAdmin() || isTester();

      allow create: if (isAdmin() || isTester()) &&
        request.resource.data.keys().hasOnly(['type','title','description','createdBy','createdAt','status','screenshotUrl']) &&
        request.resource.data.type in ['bug','improvement'] &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdBy == request.auth.token.email &&
        request.resource.data.title is string && request.resource.data.title.size() > 0 &&
        request.resource.data.description is string && request.resource.data.description.size() > 0;

      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedBy','resolvedAt']);
    }

    // Condivisione di una singola ricetta via link — vedi sharedRecipesStore.js.
    // Split in due parti perché Firestore nega la lettura a livello di
    // intero documento, mai di singolo campo: se mettessi le condizioni di
    // scaduto/revocato/ristretto direttamente sul documento con la ricetta,
    // chi riceve un link non più valido vedrebbe sempre lo stesso errore
    // generico "permission denied", senza modo di distinguere il motivo.
    // Il documento "di stato" (piccolo, senza il contenuto vero) resta
    // sempre leggibile da chiunque sia whitelistato, così il client può
    // sempre calcolare e mostrare il messaggio giusto; il contenuto vero
    // vive nella sottocollezione content/ con le condizioni reali. Stesso
    // schema di books/{bookId}/system/data (documento singolo dentro una
    // sottocollezione dedicata).
    match /sharedRecipes/{shareId} {
      function isSharer() { return isWhitelisted() && resource.data.sharedBy == request.auth.token.email; }

      allow read: if isWhitelisted();

      allow create: if isWhitelisted() &&
        request.resource.data.sharedBy == request.auth.token.email &&
        request.resource.data.keys().hasOnly(['recipeTitle', 'sharedBy', 'sharedAt', 'expiresAt', 'revoked', 'visibility', 'allowedEmails', 'sourceBookId', 'sourceRecipeId', 'includedData']) &&
        request.resource.data.revoked == false &&
        request.resource.data.visibility in ['anyone', 'restricted'] &&
        request.resource.data.allowedEmails is list &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt < request.time + duration.value(31, 'd');

      // Solo chi ha condiviso può modificare, e solo destinatari/visibilità/
      // revoca — mai il contenuto (che comunque non vive qui, ma in
      // content/), né sharedBy/sharedAt/sourceBookId/sourceRecipeId/expiresAt.
      // Permette di aggiungere un destinatario a un link già inviato senza
      // dover revocare e rimandare un nuovo link a tutti.
      allow update: if isSharer() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allowedEmails', 'visibility', 'revoked']);

      // Eliminazione reale (pulizia alla scadenza/revoca, vedi la schermata
      // "I miei link condivisi") — solo da chi ha condiviso.
      allow delete: if isSharer();

      match /content/{document} {
        function statusDoc() { return get(/databases/$(database)/documents/sharedRecipes/$(shareId)).data; }
        function isNotExpired() { return request.time < statusDoc().expiresAt; }
        function isNotRevoked() { return statusDoc().revoked != true; }
        function isSharerEmail() { return request.auth.token.email == statusDoc().sharedBy; }
        function canSeeContent() {
          return statusDoc().visibility == 'anyone' ||
            request.auth.token.email == statusDoc().sharedBy ||
            request.auth.token.email in statusDoc().allowedEmails;
        }

        // Chi ha condiviso legge SEMPRE il proprio contenuto, anche dopo
        // revoca/scadenza — serve alla pulizia (deve sapere quali foto
        // cancellare, vedi photoPaths) e in generale è ragionevole: si può
        // sempre rivedere ciò che si è condivisi, indipendentemente da
        // quando i destinatari hanno perso l'accesso.
        allow read: if isWhitelisted() && (isSharerEmail() || (isNotRevoked() && isNotExpired() && canSeeContent()));
        allow create: if isWhitelisted() &&
          statusDoc().sharedBy == request.auth.token.email &&
          request.resource.data.keys().hasOnly(['recipe', 'ingredientData', 'photoPaths']);
        // Immutabile: è una fotografia, non un documento vivo.
        allow update: if false;
        allow delete: if isWhitelisted() && statusDoc().sharedBy == request.auth.token.email;
      }
    }
  }
}
