rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isWhitelisted() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/allowlist/$(request.auth.token.email));
    }
    function isAdmin() {
      return isWhitelisted() &&
        firestore.get(/databases/(default)/documents/allowlist/$(request.auth.token.email)).data.role == "admin";
    }
    function isTester() {
      return isWhitelisted() &&
        firestore.get(/databases/(default)/documents/allowlist/$(request.auth.token.email)).data.role == "tester";
    }
    function bookMeta(bookId) {
      return firestore.get(/databases/(default)/documents/books/$(bookId)).data.meta;
    }
    function isBookOwner(bookId) {
      return bookMeta(bookId).owner == request.auth.token.email;
    }
    function isBookMember(bookId) {
      return request.auth.token.email in bookMeta(bookId).memberEmails;
    }
    // Chi può caricare/sovrascrivere foto — stessa soglia di canEditParent()
    // in firestore.rules (proprietario/collaboratore/redattore, "edit"
    // legacy incluso come alias di redattore). Il lettore resta escluso.
    // Le regole Storage non possono importare JS: specchio minimo di
    // EDITOR_ROLES in src/utils/bookRoles.js, verificato manualmente contro
    // firestore.rules perché non diverga in silenzio (nessun test automatico
    // qui: l'emulator Storage non è nella pipeline di test di questo progetto).
    function canEditBook(bookId) {
      return isBookOwner(bookId) || bookMeta(bookId).memberRoles[request.auth.token.email] in ['collaboratore', 'redattore', 'edit'];
    }

    // Ricettario Beta — libro condiviso di test, accesso per RUOLO (non
    // membership), stesso meccanismo di firestore.rules.
    match /books/b1/{allPaths=**} {
      allow read, write: if isAdmin() || isTester();
    }

    // Foto delle ricette: books/{bookId}/recipes/{recipeId}/... (dish,
    // steps/*, memories/*) — vedi services/photoStore.js per i path esatti.
    // Stessi permessi per-libro di firestore.rules (letti dal documento
    // Firestore corrispondente): lettura per owner/membri, scrittura per
    // owner o membri con ruolo "edit".
    match /books/{bookId}/{allPaths=**} {
      allow read: if isWhitelisted() && (isBookOwner(bookId) || isBookMember(bookId));
      allow write: if isWhitelisted() && canEditBook(bookId);
    }

    // Screenshot allegati alle segnalazioni beta: reports/{reportId}/screenshot.jpg
    // — stessi permessi della collezione Firestore reports (vedi firestore.rules).
    match /reports/{reportId}/{allPaths=**} {
      allow read, write: if isAdmin() || isTester();
    }

    // Foto duplicate delle ricette condivise via link — vedi
    // sharedRecipesStore.js e photoStore.js. La lettura rispecchia le
    // condizioni del documento "di stato" sharedRecipes/{shareId} in
    // firestore.rules (non scaduto, non revocato, visibilità); la scrittura
    // (creazione alla condivisione, eliminazione alla pulizia) è permessa
    // solo a chi ha creato la condivisione. Mai un aggiornamento: sono
    // fotografie immutabili, non le foto vive della ricetta originale.
    function sharedStatus(shareId) {
      return firestore.get(/databases/(default)/documents/sharedRecipes/$(shareId)).data;
    }
    function sharedIsSharer(shareId) {
      return sharedStatus(shareId).sharedBy == request.auth.token.email;
    }
    function sharedCanRead(shareId) {
      return sharedStatus(shareId).revoked != true &&
        request.time < sharedStatus(shareId).expiresAt &&
        (sharedStatus(shareId).visibility == 'anyone' ||
         request.auth.token.email == sharedStatus(shareId).sharedBy ||
         request.auth.token.email in sharedStatus(shareId).allowedEmails);
    }
    match /sharedRecipes/{shareId}/{allPaths=**} {
      allow read: if isWhitelisted() && sharedCanRead(shareId);
      allow write: if isWhitelisted() && sharedIsSharer(shareId);
    }
  }
}
